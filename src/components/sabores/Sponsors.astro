---
// `sponsors` llega con los logoUrl ya apuntando a Minio (transformado en el service).
interface Sponsor {
  name: string;
  logoUrl: string;
}
interface Props {
  sponsors: { patrocinadores: Sponsor[]; apoiadores: Sponsor[] };
}
const { patrocinadores, apoiadores } = Astro.props.sponsors;
---

<section id="patrocinio" class="py-10 md:py-16 bg-transparent relative z-10 scroll-reveal">
  <div class="container mx-auto px-6 max-w-[90rem]">
    <div class="sponsors-heading">
      <span class="sponsors-heading-rule sponsors-heading-rule--left"></span>
      <h4 class="sponsors-heading-title">
        Marcas parceiras que aquecem o nosso <span class="text-gold">inverno</span>
      </h4>
      <span class="sponsors-heading-rule sponsors-heading-rule--right"></span>
    </div>

    <div class="sponsors-stack">
      <!-- Patrocinadores (scroll izquierda) -->
      <div class="sponsors-row-group">
        <h5 class="sponsors-row-label">Patrocinadores</h5>
        <div class="sponsors-row-container">
          <div class="sponsors-logos sponsors-logos--main">
            {patrocinadores.map((logo) => (
              <div class="sponsor-logo-item" title={logo.name}>
                <img
                  src={logo.logoUrl}
                  alt={`Logo da marca patrocinadora ${logo.name}`}
                  class="sponsor-logo-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Apoiadores (scroll derecha) -->
      <div class="sponsors-row-group">
        <h5 class="sponsors-row-label">Apoiadores</h5>
        <div class="sponsors-row-container">
          <div class="sponsors-logos sponsors-logos--support">
            {apoiadores.map((logo) => (
              <div class="sponsor-logo-item" title={logo.name}>
                <img
                  src={logo.logoUrl}
                  alt={`Logo da marca apoiadora ${logo.name}`}
                  class="sponsor-logo-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
