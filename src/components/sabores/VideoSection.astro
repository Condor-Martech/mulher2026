---
import content from "../../data/sabores/content.json";
const video = content.video;
---

<section id="video" class="content-section bg-transparent pt-4 pb-12 scroll-reveal relative overflow-hidden">
  <div class="ambient-copper-glow"></div>

  <div class="container mx-auto px-6 max-w-5xl relative z-10">
    <div class="section-title-group mb-12">
      <span class="section-pretitle">{video.pretitle}</span>
      <h2 class="section-main-title">{video.title}</h2>
      <p class="section-subtitle">{video.subtitle}</p>
    </div>

    <div class="video-terminal-frame">
      <div class="video-aspect-wrapper">
        <iframe
          id="sabores-video"
          data-video-id={video.youtubeId}
          src={`https://www.youtube.com/embed/${video.youtubeId}?autoplay=0&rel=0&modestbranding=1&enablejsapi=1`}
          title="Sabores de Inverno Condor"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          class="video-iframe"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  import { track } from "../../lib/track";

  // Emite `video_play` la primera vez que el player entra en PLAYING.
  // Usa la IFrame Player API de YouTube para no alterar el diseño del embed.
  function initSaboresVideoTracking() {
    const iframe = document.getElementById("sabores-video");
    if (!iframe) return;
    let fired = false;
    const w = window as any;

    const attach = () => {
      new w.YT.Player("sabores-video", {
        events: {
          onStateChange: (e: any) => {
            // 1 === YT.PlayerState.PLAYING
            if (!fired && e.data === 1) {
              fired = true;
              track("video_play", {
                video_id: iframe.getAttribute("data-video-id") || "",
              });
            }
          },
        },
      });
    };

    if (w.YT && w.YT.Player) {
      attach();
      return;
    }
    const prev = w.onYouTubeIframeAPIReady;
    w.onYouTubeIframeAPIReady = () => {
      if (typeof prev === "function") prev();
      attach();
    };
    if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
      const tag = document.createElement("script");
      tag.src = "https://www.youtube.com/iframe_api";
      document.head.appendChild(tag);
    }
  }

  initSaboresVideoTracking();
</script>
