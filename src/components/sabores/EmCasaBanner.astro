---
// Banner "Condor em Casa" (entrega a domicilio). Identidad AZUL de Condor em Casa,
// con CTA, profundidad y el lockup "Condor em CASA" a la derecha.
import content from "../../data/sabores/content.json";
const emCasa = content.emCasa;
---

<section class="py-2 lg:py-8 bg-transparent relative z-10 scroll-reveal">
  <div class="container mx-auto px-6 max-w-[90rem] flex justify-center">
    <a
      href={emCasa.link}
      target="_blank"
      rel="noopener noreferrer"
      data-track="condor_em_casa_clicked"
      data-placement="banner_em_casa"
      aria-label="Condor em Casa — faça suas compras e levamos até você"
      class="group relative w-full max-w-[1100px] overflow-hidden
             flex flex-col md:flex-row items-center justify-between gap-7 md:gap-10
             rounded-[20px] md:rounded-[28px] border border-white/30
             bg-gradient-to-br from-[#0a57a3] via-[#0f6cb8] to-[#1c84cc]
             px-8 py-6 md:px-14 md:py-10
             shadow-[0_18px_50px_rgba(0,80,165,0.45)]
             transition-all duration-500 hover:border-white/55 hover:shadow-[0_26px_70px_rgba(0,80,165,0.6)]"
    >
      <!-- Glow para profundidad -->
      <span
        class="pointer-events-none absolute inset-0 z-0 rounded-[20px] md:rounded-[28px]
               bg-[radial-gradient(ellipse_at_18%_25%,rgba(255,255,255,0.22),transparent_55%),radial-gradient(ellipse_at_92%_85%,rgba(0,35,80,0.45),transparent_55%)]"
      ></span>

      <!-- Copy -->
      <div class="relative z-10 text-center md:text-left">
        <h2
          class="font-sans font-extrabold text-white text-2xl md:text-3xl lg:text-[2.3rem] leading-tight tracking-tight mb-2 drop-shadow-[0_2px_10px_rgba(0,0,0,0.25)]"
        >
          {emCasa.title}
        </h2>
        <p class="font-sans text-white/90 text-lg md:text-xl leading-snug">
          {emCasa.subtitlePre}<strong class="font-extrabold text-white"
            >{emCasa.subtitleStrong}</strong
          >
        </p>
      </div>

      <!-- Lockup Condor em CASA -->
      <img
        src={emCasa.logo}
        alt="Condor em Casa"
        width="320"
        height="180"
        class="relative z-10 h-24 md:h-28 lg:h-32 w-auto shrink-0
               drop-shadow-[0_10px_24px_rgba(0,0,0,0.35)]
               transition-transform duration-500 group-hover:scale-105"
      />
    </a>
  </div>
</section>
