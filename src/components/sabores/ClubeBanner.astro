---
import content from "../../data/sabores/content.json";
const clube = content.clube;
---

<section class="py-2 lg:py-8 bg-transparent relative z-10 scroll-reveal">
  <div class="container mx-auto px-6 max-w-[90rem] flex justify-center">
    <a
      href={clube.link}
      target="_blank"
      rel="noopener noreferrer"
      data-track="promo_banner_clicked"
      data-destination="clube"
      data-placement="clube_banner"
      class="relative w-full flex items-center group transition-all hover:brightness-105"
    >
      <div class="relative z-10 flex flex-col md:flex-row items-center w-full">
        <!-- Logo Clube Condor - superpuesto -->
        <div class="shrink-0 relative z-20 mb-[-1.5rem] md:mb-0 md:-mr-12 lg:-mr-20 2xl:-mr-24">
          <img
            src={clube.logo}
            alt="Clube Condor"
            width="300"
            height="200"
            class="h-32 md:h-36 lg:h-44 xl:h-48 2xl:h-52 w-auto drop-shadow-2xl transition-transform group-hover:scale-105"
          />
        </div>

        <!-- Banner azul -->
        <div
          class="w-full md:flex-1 flex flex-col justify-center leading-[1.1] bg-gradient-to-r from-[#0060AA] to-[#0089D0] rounded-[18px] lg:rounded-[22px] pt-6 pb-4 px-6 md:pl-20 md:pr-6 lg:pl-32 lg:pr-12 md:py-1.5 lg:py-3 xl:py-4 2xl:py-6 shadow-[0_8px_32px_rgba(0,96,170,0.4)] border-2 border-white/10 text-center md:text-left"
        >
          <h2 class="text-white font-sans font-black text-[20px] xs:text-[24px] lg:text-[1.8rem] xl:text-[2.2rem] 2xl:text-[2.6rem] tracking-tight leading-tight uppercase">
            {clube.titleLine1}
          </h2>
          <p class="text-white/90 font-sans font-light text-[15px] xs:text-lg lg:text-[1.3rem] xl:text-[1.6rem] 2xl:text-[1.9rem] tracking-tight leading-tight">
            {clube.titleLine2}
          </p>
        </div>
      </div>
    </a>
  </div>
</section>
