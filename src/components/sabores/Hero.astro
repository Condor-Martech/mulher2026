---
// Hero — banner por capas (foto BG + branding + cluster promo). Los assets llegan
// por props desde la página (content.hero), ya apuntando a Minio vía el service.
import CondorPremiaCluster from "./CondorPremiaCluster.astro";

interface Props {
  hero?: {
    bg?: string;
    // Branding completo en una sola pieza (título + logo + cartel + aviso de bebidas),
    // fondo transparente. Reemplaza a los assets sueltos de título/logo/cartel.
    selo?: string;
  };
  premia?: Record<string, string>;
}
// Guard defensivo: si el content remoto llega incompleto, `hero`/`premia` pueden
// faltar. Usamos {} para no romper el acceso a propiedades; los <img> sin src
// simplemente no cargan, pero la página no tira 500.
const { hero = {}, premia } = Astro.props;
// Branding del hero como imagen única. Content-driven (Minio) con fallback local,
// así renderiza aunque el JSON remoto todavía no traiga el nuevo `selo`.
const selo =
  hero.selo ?? "/assets/sabores-de-inverno/Selo-Sabores-de-Inverno.png";
---

<section id="home" class="hero-section">
  <!-- Capa 0: foto de fondo -->
  <img
    src={hero.bg}
    alt="Mesa invernal premium Condor"
    class="hero-bg-img"
    fetchpriority="high"
  />
  <div class="hero-top-vignette"></div>

  <!-- Capa 1: contenido (branding izq / cluster der) -->
  <div class="hero-content">
    <div class="hero-left-block">
      <!-- Branding completo en una sola imagen: título "Sabores de Inverno", logo
           Condor, cartel "…momentos que ficam." y el aviso legal de bebidas. -->
      <img
        src={selo}
        alt="Sabores de Inverno — Condor. Sabores que aquecem, momentos que ficam. Aprecie com moderação: é proibida a venda de bebidas alcoólicas a menores de 18 anos."
        class="hero-selo"
        fetchpriority="high"
      />
    </div>

    <div class="hero-right-block">
      <CondorPremiaCluster premia={premia} />
    </div>
  </div>
</section>
