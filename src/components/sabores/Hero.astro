---
// Hero — banner por capas (foto BG + branding + cluster promo). Los assets llegan
// por props desde la página (content.hero), ya apuntando a Minio vía el service.
import CondorPremiaCluster from "./CondorPremiaCluster.astro";

interface Props {
  hero: {
    bg: string;
    tituloSabores: string;
    tituloDe: string;
    tituloInverno: string;
    logoCondor: string;
    signWood: string;
    signText: string;
  };
  premia: Record<string, string>;
}
const { hero, premia } = Astro.props;
---

<section id="home" class="hero-section">
  <!-- Capa 0: foto de fondo -->
  <img
    src={hero.bg}
    alt="Mesa invernal premium Condor"
    class="hero-bg-img"
    fetchpriority="high"
  />
  <div class="hero-top-vignette"></div>

  <!-- Capa 1: contenido (branding izq / cluster der) -->
  <div class="hero-content">
    <div class="hero-left-block">
      <div class="hero-title">
        <img src={hero.tituloSabores} alt="Sabores" class="ht-sabores" />
        <div class="ht-line2">
          <img src={hero.tituloDe} alt="de" class="ht-de" />
          <img src={hero.tituloInverno} alt="Inverno" class="ht-inverno" />
        </div>
      </div>

      <img src={hero.logoCondor} alt="Condor" class="hero-logo" />

      <div class="hero-sign">
        <img src={hero.signWood} alt="" class="hero-sign-wood" aria-hidden="true" />
        <img
          src={hero.signText}
          alt="Sabores que aquecem, momentos que ficam"
          class="hero-sign-text"
        />
      </div>
    </div>

    <div class="hero-right-block">
      <CondorPremiaCluster premia={premia} />
    </div>
  </div>
</section>
