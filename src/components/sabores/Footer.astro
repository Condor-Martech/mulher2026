---
// Footer premium de Sabores. Logo, copyright y redes vienen de `content.footer`
// (Minio + fallback local, transformado en el service). Guard defensivo con
// defaults por si el content remoto todavía no trae el bloque `footer`.
interface SocialLink {
  network: string;
  url: string;
  color: string;
  label: string;
}
interface FooterContent {
  logo?: string;
  copyright?: string;
  social?: SocialLink[];
}
interface Props {
  footer?: FooterContent;
}

const DEFAULT_SOCIAL: SocialLink[] = [
  { network: "facebook", url: "https://facebook.com/redecondor", color: "#1877F2", label: "Facebook" },
  { network: "instagram", url: "https://instagram.com/redecondor", color: "#E4405F", label: "Instagram" },
  { network: "youtube", url: "https://youtube.com/redecondor", color: "#FF0000", label: "YouTube" },
];

const f = Astro.props.footer ?? {};
const logo = f.logo ?? "/assets/sabores-de-inverno/hero-logo-condor.png";
const copyright = f.copyright ?? "© 2026 Condor. Todos os direitos reservados.";
const social = f.social?.length ? f.social : DEFAULT_SOCIAL;

// Los iconos (markup SVG) viven acá, no en el JSON. Cada red mapea a su `path`.
// Redes sin icono conocido se omiten en vez de romper.
const ICONS: Record<string, string> = {
  facebook:
    "M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z",
  instagram:
    "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z",
  youtube:
    "M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
};
const socialLinks = social.filter((s) => ICONS[s.network]);
---

<footer class="premium-footer">
  <div class="footer-container">
    <img src={logo} alt="Logo Condor" class="footer-logo" />

    <p class="footer-copyright">{copyright}</p>

    <div class="footer-social-wrapper" role="list">
      {
        socialLinks.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            data-track="social_link_clicked"
            data-network={s.network}
            class="footer-social-link"
            style={`background: ${s.color};`}
            aria-label={s.label}
            role="listitem"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-white">
              <path d={ICONS[s.network]} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</footer>
