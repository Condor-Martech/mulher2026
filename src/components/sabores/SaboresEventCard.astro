---
import type { Event } from "../../types/event";
import { getEventStatus } from "../../services/saboresEventService";
import { toSaboresCdn } from "../../services/saboresContentService";

interface Sponsor {
  name: string;
  logoUrl: string;
}
interface Props {
  event: Event;
  // Pasados desde SaboresEventGrid (vienen del content de Minio, ya transformados).
  sponsors: { patrocinadores: Sponsor[]; apoiadores: Sponsor[] };
  statusMap: Record<string, { label: string; cta: string; disabled: boolean }>;
}
const { event, sponsors, statusMap } = Astro.props;

// Estado por canal SOCIAL (la grilla pública = canal social → cupo qtd_social).
const status = getEventStatus(event, "social");
// Guard defensivo: si statusMap llega vacío (content remoto incompleto), caemos a
// un config seguro en vez de romper al leer statusCfg.label/cta/disabled.
const statusCfg = statusMap?.[status] ??
  statusMap?.SOON ?? { label: "Em breve", cta: "Em breve", disabled: true };

// --- Fecha (America/Sao_Paulo) ---
const dateObj = new Date(event.data_evento);
const valid = !isNaN(dateObj.getTime());
const part = (opts: Intl.DateTimeFormatOptions) =>
  valid
    ? new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", ...opts })
        .format(dateObj)
        .replace(".", "")
    : "";
const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
const time =
  event.time_label && event.time_label.toLowerCase() !== "a definir"
    ? event.time_label
    : "";
// Fecha destacada de la card (Opción B): eyebrow con el día de la semana + fecha grande.
const weekdayLabel = valid ? cap(part({ weekday: "long" })) : "";
const dateMain = valid ? part({ day: "2-digit", month: "long" }) : "Data a definir";
// Fecha completa (con día de la semana) para el modal.
const dateFull = valid
  ? `${cap(part({ weekday: "long" }))}, ${part({ day: "2-digit", month: "long" })}${time ? ` · ${time}` : ""}`
  : "Data a definir";

// --- Ciudad / sede ---
const REGION_NAMES: Record<string, string> = {
  curitiba: "Curitiba",
  maringa: "Maringá",
  pontagrossa: "Ponta Grossa",
};
const regionKey = (event.region ?? "").toLowerCase().replace(/\s+/g, "");
const city = REGION_NAMES[regionKey] ?? event.region ?? "";
// Nombre completo del supermercado (p.ej. "Hiper Condor Torres"); fallback a la ciudad.
const store = (event.location ?? "").trim();

// Link a Google Maps: override explícito por evento (data.maps_url) o búsqueda por
// nombre de tienda + ciudad (sin API key; resuelve al pin para tiendas con nombre).
const mapsOverride =
  (event.data?.maps_url as string | undefined) ??
  (event.data?.mapsUrl as string | undefined);
const mapsQuery = [event.location, city].filter(Boolean).join(" ").trim();
const mapsUrl =
  mapsOverride ||
  (mapsQuery
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`
    : null);

// --- Capa (slug = event id) ---
const cover = toSaboresCdn(`/assets/sabores-de-inverno/eventos/${event.id}.jpg`);

const sponsorLabel = event.brand ?? event.sponsor ?? "";

// Logo del patrocinador del evento: reemplaza el logo genérico de Condor en el
// brandmark de la portada. Se busca por nombre normalizado (sin acentos/espacios,
// p.ej. "3 Corações" → "3coracoes") contra sponsors.json. Fallback: logo de Condor.
const normalizeBrand = (s: string) =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]/g, "");
const sponsorLogoByBrand = new Map<string, string>(
  [...sponsors.patrocinadores, ...sponsors.apoiadores].map(
    (s) => [normalizeBrand(s.name), s.logoUrl] as [string, string],
  ),
);
const sponsorKey = normalizeBrand(sponsorLabel);
const sponsorLogo = sponsorKey ? sponsorLogoByBrand.get(sponsorKey) ?? null : null;
const brandmarkSrc =
  sponsorLogo ?? toSaboresCdn("/assets/sabores-de-inverno/condor-logo.png");
const brandmarkAlt = sponsorLogo ? sponsorLabel || "Patrocinador" : "Condor";

// El título a veces trae un prefijo "…Marca…:" (p.ej. "Chá Leão: …") redundante
// con el logo del patrocinador. Si el segmento antes del primer ":" menciona la
// marca del evento, lo quitamos y mostramos solo el subtítulo real.
const stripRedundantBrandPrefix = (tema: string): string => {
  const i = tema.indexOf(":");
  if (i === -1 || !sponsorLabel) return tema;
  const prefix = tema.slice(0, i);
  return normalizeBrand(prefix).includes(normalizeBrand(sponsorLabel))
    ? tema.slice(i + 1).trim()
    : tema;
};
const title = stripRedundantBrandPrefix(event.tema);

// Palestrante para el modal (oculta placeholders "a definir/confirmar").
const speaker =
  event.palestrante &&
  !/^a\s+(definir|confirmar)/i.test(event.palestrante.trim())
    ? event.palestrante
    : "";
---

<article class="sabores-event-card" data-status={status}>
  <!-- Capa del evento -->
  <div class="sabores-card-cover">
    <div class="sabores-card-cover-media">
      <img
        src={cover}
        alt={event.tema}
        loading="lazy"
        decoding="async"
      />
    </div>
    <span class="sabores-card-status">
      {statusCfg.label}
    </span>
    <span class="sabores-card-brandmark">
      <img
        src={brandmarkSrc}
        alt={brandmarkAlt}
        data-brand={sponsorLogo ? sponsorKey : undefined}
        loading="lazy"
        decoding="async"
      />
    </span>
  </div>

  <!-- Cuerpo marrón -->
  <div class="sabores-card-body">
    <div class="sabores-card-date">
      {weekdayLabel && <span class="sabores-card-weekday">{weekdayLabel}</span>}
      <p class="sabores-card-date-main">
        {dateMain}{time && <span class="sabores-card-time"> · {time}</span>}
      </p>
    </div>

    <h3 class="sabores-card-title">{title}</h3>

    {
      ((!sponsorLogo && sponsorLabel) || event.palestrante) && (
        <div class="sabores-card-credits">
          {!sponsorLogo && sponsorLabel && (
            <div class="sabores-card-brand">
              <span class="sabores-card-brand-label">Apresentado por</span>
              <span class="sabores-card-brand-name">{sponsorLabel}</span>
            </div>
          )}
          {event.palestrante && (
            <div class="sabores-card-speaker">
              <span class="sabores-card-speaker-label">Palestrante</span>
              <span class="sabores-card-speaker-name">{event.palestrante}</span>
            </div>
          )}
        </div>
      )
    }

    <div class="sabores-card-meta">
      {
        mapsUrl ? (
          <a
            class="sabores-card-map"
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ${store || city} no Google Maps`}
          >
            <svg class="sabores-card-map-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
              <circle cx="12" cy="11" r="3" />
            </svg>
            <span class="sabores-card-map-text">
              <span class="sabores-card-map-place">{store || city}</span>
              <span class="sabores-card-map-cta">Ver no mapa</span>
            </span>
            <svg class="sabores-card-map-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
            </svg>
          </a>
        ) : (
          <span class="sabores-card-meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
              <circle cx="12" cy="11" r="3" />
            </svg>
            <span>{store || city}</span>
          </span>
        )
      }
    </div>

    <button
      type="button"
      class="open-sabores-modal sabores-card-cta"
      disabled={statusCfg.disabled}
      data-event-id={event.id}
      data-event-tema={title}
      data-event-date={dateFull}
      data-event-city={city}
      data-event-location={event.location ?? ""}
      data-event-maps-url={mapsUrl ?? ""}
      data-event-palestrante={speaker}
    >
      {statusCfg.cta}
    </button>
  </div>
</article>
