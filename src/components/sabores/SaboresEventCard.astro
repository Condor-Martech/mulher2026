---
import type { Event } from "../../types/event";
import { getEventStatus } from "../../services/saboresEventService";
import content from "../../data/sabores/content.json";

interface Props {
  event: Event;
}
const { event } = Astro.props;

// Estado por canal SOCIAL (la grilla pública = canal social → cupo qtd_social).
const status = getEventStatus(event, "social");
const statusMap = content.status as Record<
  string,
  { label: string; cta: string; disabled: boolean }
>;
const statusCfg = statusMap[status] ?? statusMap.SOON;
const isOpen = status === "OPEN";

// --- Fecha (America/Sao_Paulo) ---
const dateObj = new Date(event.data_evento);
const valid = !isNaN(dateObj.getTime());
const part = (opts: Intl.DateTimeFormatOptions) =>
  valid
    ? new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", ...opts })
        .format(dateObj)
        .replace(".", "")
    : "";
const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
const time =
  event.time_label && event.time_label.toLowerCase() !== "a definir"
    ? event.time_label
    : "";
// Eyebrow compacto de la card (la fecha es lo que diferencia dentro de una ciudad).
const dateBadge = valid
  ? `${part({ day: "2-digit", month: "long" })}${time ? ` · ${time}` : ""}`
  : "Data a definir";
// Fecha completa (con día de la semana) para el modal.
const dateFull = valid
  ? `${cap(part({ weekday: "long" }))}, ${part({ day: "2-digit", month: "long" })}${time ? ` · ${time}` : ""}`
  : "Data a definir";

// --- Ciudad / sede ---
const REGION_NAMES: Record<string, string> = {
  curitiba: "Curitiba",
  maringa: "Maringá",
  pontagrossa: "Ponta Grossa",
};
const regionKey = (event.region ?? "").toLowerCase().replace(/\s+/g, "");
const city = REGION_NAMES[regionKey] ?? event.region ?? "";
// Tienda sin el prefijo "Hiper Condor" (ya se ve en branding); fallback a la ciudad.
const store = (event.location ?? "").replace(/^Hiper\s+Condor\s*/i, "").trim();

// Link a Google Maps: override explícito por evento (data.maps_url) o búsqueda por
// nombre de tienda + ciudad (sin API key; resuelve al pin para tiendas con nombre).
const mapsOverride =
  (event.data?.maps_url as string | undefined) ??
  (event.data?.mapsUrl as string | undefined);
const mapsQuery = [event.location, city].filter(Boolean).join(" ").trim();
const mapsUrl =
  mapsOverride ||
  (mapsQuery
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`
    : null);

// --- Capa (slug = event id) ---
const cover = `/assets/sabores-de-inverno/eventos/${event.id}.jpg`;

const sponsorLabel = event.brand ?? event.sponsor ?? "";
---

<article class:list={["sabores-event-card", { "is-closed": statusCfg.disabled }]}>
  <!-- Capa del evento -->
  <div class="sabores-card-cover">
    <img
      src={cover}
      alt={event.tema}
      loading="lazy"
      decoding="async"
    />
    <span class:list={["sabores-card-status", isOpen ? "is-open" : "is-off"]}>
      {statusCfg.label}
    </span>
    {
      event.requiresAge && <span class="sabores-card-age">+18</span>
    }
  </div>

  <!-- Cuerpo marrón -->
  <div class="sabores-card-body">
    <p class="sabores-card-date">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="4" width="18" height="17" rx="2" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18M8 2v4M16 2v4" />
      </svg>
      {dateBadge}
    </p>

    <h3 class="sabores-card-title">{event.tema}</h3>

    {sponsorLabel && <span class="sabores-card-sponsor">{sponsorLabel}</span>}

    {
      event.palestrante && (
        <div class="sabores-card-speaker">
          <span class="sabores-card-speaker-info">
            <span class="sabores-card-speaker-label">Palestrante</span>
            <span class="sabores-card-speaker-name">{event.palestrante}</span>
          </span>
        </div>
      )
    }

    <div class="sabores-card-meta">
      {
        mapsUrl ? (
          <a
            class="sabores-card-map"
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ${store || city} no Google Maps`}
          >
            <span class="sabores-card-map-pin" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                <circle cx="12" cy="11" r="3" />
              </svg>
            </span>
            <span class="sabores-card-map-text">
              <span class="sabores-card-map-place">{store || city}</span>
              <span class="sabores-card-map-cta">Ver no mapa</span>
            </span>
            <svg class="sabores-card-map-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
            </svg>
          </a>
        ) : (
          <span class="sabores-card-meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
              <circle cx="12" cy="11" r="3" />
            </svg>
            <span>{store || city}</span>
          </span>
        )
      }
    </div>

    <button
      type="button"
      class="open-sabores-modal sabores-card-cta"
      disabled={statusCfg.disabled}
      data-event-id={event.id}
      data-event-tema={event.tema}
      data-event-date={dateFull}
      data-event-city={city}
      data-event-location={event.location ?? ""}
      data-event-requires-age={event.requiresAge ? "1" : "0"}
    >
      {statusCfg.cta}
    </button>
  </div>
</article>
