---
// Hero: a foto sangrada, o menu flutuante e o selo da campanha.
//
// MEDIDAS DO FIGMA (frame 1:2, tela 1440×2498 · frame mobile 1:1243, 393×1593)
//   faixa da foto   1443 × 1020   →  proporção 1.415 · mobile 393 × 296 → 1.328
//   pílula do menu  x 617  y 70   w 650  h 56   (branca, raio total)
//     Home 681 · Trajeto 826 · Dúvidas 976.5 · Regulamento 1145.5, y 89
//     sublinhado sob Home: x 656 y 108 w 50 h 3
//   selo            x 85   y 194  w 802  h 412
//     mobile:       x 68   y 39   w 246  h 135
//
// As posições vão em % do contêiner (não em px fixos) para o bloco escalar
// junto com a largura mantendo a proporção do design. Em 1440 caem no pixel
// exato; abaixo disso interpolam.
import {
  toEncontroCdn,
  type ConteudoEncontro,
} from "../../services/encontroContentService";

// O menu do Figma tem quatro entradas, mas só duas seções existem nesta
// página. «Trajeto» veio de outra campanha (um passeio ciclístico) e não faz
// sentido num jantar; «Dúvidas» e «Regulamento» não foram desenhadas.
// Linkamos o que existe e deixamos anotado para o design resolver — a lista
// mora em hero.menu no content.json.
interface Props {
  hero: ConteudoEncontro["hero"];
}
const { hero } = Astro.props;

// A foto do hero não passa pelo content.json (são três variantes de largura
// para o srcset), então o caminho vai pelo helper na mão. É para isso que o
// toEncontroCdn existe, igual ao toSaboresCdn.
const FOTO = (largura: number) =>
  toEncontroCdn(`/assets/encontro-de-sabores/images/hero-${largura}.webp`);
---

<section id="home" class="relative w-full overflow-hidden">
  <img
    src={FOTO(1280)}
    srcset={`${FOTO(768)} 768w, ${FOTO(1280)} 1280w, ${FOTO(1920)} 1920w`}
    sizes="100vw"
    alt=""
    aria-hidden="true"
    width="1920"
    height="1599"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover object-[50%_72%]"
  />

  {/* Proporção do design: mobile 393/296, desktop 1443/1020. */}
  {/* A proporção do Figma (1443/1020) dá 1018px de altura a 1440 de largura:
        mais que a janela de um notebook, então o hero preenchia a tela e nada
        indicava que havia conteúdo abaixo. Cortamos em 86svh para aparecer a
        faixa laranja da seção seguinte. `svh` e não `vh`: no mobile o `vh`
        conta a barra de endereços e deixa o corte no lugar errado.
        Quem absorve o corte é a foto (object-cover); o selo vai em % do
        contêiner, então diminui junto com ele e a composição se mantém. */}
  <div
    class="relative mx-auto aspect-[393/296] max-h-[86svh] w-full max-w-[1440px] md:aspect-[1443/1020]"
  >
    {/* Pílula do menu. No Figma mobile ela não existe, então aparece do md pra cima. */}
    <nav
      aria-label={hero.navRotulo}
      class="absolute hidden md:block"
      style="left:42.847%; top:6.863%; width:45.139%;"
    >
      <ul
        class="flex h-[3.89vw] max-h-[56px] items-center justify-between rounded-full bg-white px-[3.6%] font-archivo text-[clamp(12px,1.11vw,16px)] font-bold text-encontro-tijolo"
      >
        {hero.menu.map((item) => (
          <li>
            <a
              href={item.href}
              data-track="encontro_menu"
              class:list={[
                "inline-block whitespace-nowrap py-1 transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-encontro-tijolo",
                item.ativo && "border-b-[3px] border-encontro-tijolo",
              ]}
            >
              {item.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Selo: 802/1440 = 55.69% de largura, a 85px (5.90%) da borda e 194px
        (19.02% de 1020) da altura. No mobile: 246/393 = 62.6%, centrado a 68px. */}
    <img
      src={hero.selo}
      alt={hero.seloAlt}
      width="1200"
      height="656"
      fetchpriority="high"
      decoding="async"
      class="absolute left-[17.3%] top-[13.18%] h-[45.6%] w-[62.6%] object-contain object-left md:left-[5.903%] md:top-[19.02%] md:h-[40.39%] md:w-[55.694%]"
    />

    {/* Indicador de scroll. O corte em 86svh deixa aparecer a faixa
        laranja, mas no notebook isso vira uma tira fina e nem sempre se
        lê como «tem mais coisa abaixo». A linha cresce para baixo e se
        recolhe pelo mesmo lado. Só do md pra cima: no frame mobile o hero
        mede 393×296 e o conteúdo seguinte já aparece sem ajuda.
        Quem a deixa parada é o bloco de prefers-reduced-motion da folha. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute bottom-[4%] left-1/2 hidden h-10 w-px -translate-x-1/2 overflow-hidden bg-encontro-creme/25 md:block"
    >
      <span class="block h-full w-full bg-encontro-creme animate-descer"></span>
    </div>
  </div>
</section>
