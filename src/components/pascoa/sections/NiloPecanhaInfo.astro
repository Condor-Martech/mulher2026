---
interface Props {
  data: {
    headline: string[];
    description: string;
    dates: string;
    address: string;
  };
}

const { data } = Astro.props;
---

<section
  id="nilopecanha"
  class="relative w-full max-w-[900px] mx-auto py-12 px-6 flex flex-col items-center text-center gap-6 z-20 font-['Montserrat',sans-serif] font-extrabold"
>
  <!-- Headline -->
  <header class="w-full mb-1">
    <h2 class="flex flex-col uppercase tracking-[-0.02em] leading-[1.1]">
      <span class="text-[clamp(1.1rem,2.5vw,1.8rem)] text-[#712306]">
        {data.headline[0]}
      </span>
      <span
        class="text-[clamp(1.8rem,4.8vw,3.4rem)] text-[#712306] leading-[0.9] tracking-[-0.05em] font-black"
      >
        {data.headline[1]}
      </span>
    </h2>
  </header>

  <!-- Description -->
  <p
    class="text-[clamp(0.85rem,1.4vw,1.05rem)] text-[#712306] max-w-[65ch] leading-[1.35] m-0"
  >
    {data.description}
  </p>

  <!-- Dark card -->
  <div
    class="bg-[radial-gradient(circle_at_center,#491703_0%,#310b01_100%)] rounded-[35px] p-[clamp(1.5rem,4vw,2.5rem)] mt-4 max-w-[589px] min-h-[209px] w-full text-center flex flex-col justify-center items-center shadow-none border-none"
  >
    <p
      class="text-[clamp(1.2rem,2.8vw,1.6rem)] text-[#ffb600] leading-[1.3] whitespace-pre-line m-0 mb-4 tracking-[-0.01em] font-black"
    >
      {data.dates}
    </p>
    <p
      class="text-[clamp(0.85rem,1.4vw,1rem)] text-white/90 font-medium tracking-[0.02em] m-0"
    >
      {data.address}
    </p>
  </div>
</section>
