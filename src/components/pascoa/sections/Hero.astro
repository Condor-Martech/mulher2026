---
interface Props {
  data: {
    mascotImg: string;
    txtImg: string;
    badges: {
      desktop: string;
      mobile: string;
    };
  };
}

const { data } = Astro.props;
---

<section
  id="hero"
  class="relative w-full flex flex-col items-center justify-start overflow-hidden min-h-[700px] md:h-[650px] lg:h-[650px] max-[900px]:h-auto! max-[900px]:min-h-[70vh]!"
>
  <div
    class="w-full max-w-5xl mx-auto px-4 pt-14 md:pt-20 pb-2 flex flex-col md:flex-row items-center justify-center gap-10 z-10 max-[900px]:flex-col! max-[900px]:gap-8! max-[900px]:pt-24! max-[900px]:pb-6!"
  >
    <div
      class="w-full md:w-3/5 flex items-center justify-center animate-float shrink-0 mt-24 max-[900px]:w-full! max-[900px]:mt-12!"
    >
      <img
        src={data.mascotImg}
        alt="Mascota Condor"
        class="w-full md:w-full max-w-[420px] md:max-w-[350px] lg:max-w-none h-auto object-contain drop-shadow-2xl scale-[1.3] md:scale-100 lg:scale-[1.45] xl:scale-[1.65] origin-center -translate-y-6 md:translate-y-0 max-[900px]:scale-[1.25]! max-[900px]:max-w-[480px]!"
      />
    </div>

    <div
      class="w-full md:w-2/5 flex flex-col items-center justify-center gap-2 mt-4 md:mt-12 md:-ml-36 max-[900px]:w-full! max-[900px]:ml-0! max-[900px]:mt-0!"
    >
      <img
        src={data.badges.mobile}
        alt="Oferta Especial"
        class="md:hidden w-[95%] max-w-[20rem] h-auto object-contain drop-shadow-xl max-[900px]:block! max-[900px]:max-w-[320px]!"
      />

      <img
        src={data.badges.desktop}
        alt="Condiciones de Pago"
        class="hidden md:block w-full md:w-[70%] max-w-[320px] md:max-w-[200px] lg:w-[125%] lg:max-w-sm xl:w-[135%] xl:max-w-md h-auto object-contain drop-shadow-xl shrink-0 md:h-96 max-[900px]:hidden!"
      />

      <img
        src={data.txtImg}
        alt="A Maior Páscoa do Brasil"
        class="w-[85%] max-w-64 md:w-full md:max-w-[280px] lg:w-[80%] lg:max-w-48 xl:w-[90%] xl:max-w-48 h-auto object-contain shrink-0 max-[900px]:w-[60%]! max-[900px]:max-w-[300px]!"
      />
    </div>
  </div>
</section>
