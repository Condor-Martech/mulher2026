---
import { getMaesContent } from "../../services/maesService";

const data = await getMaesContent();
const { ui } = data;
---

<section class="pb-4 lg:pb-14 text-center bg-maes-wine">
  <a
    href="#regulamento"
    class="inline-block px-12 py-3 rounded-full font-maes-sans font-bold text-sm uppercase tracking-wide transition-all hover:scale-[1.03] bg-maes-card text-maes-primary shadow-[0_12px_24px_-10px_rgba(0,0,0,0.35)]"
  >
    {ui.knowMore}
  </a>
</section>
