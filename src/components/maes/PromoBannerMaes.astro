---
import { getMaesContent } from "../../services/maesService";

const data = await getMaesContent();
const { promoBanner } = data;
---

<section class="pt-24 md:pt-28 lg:pt-24 pb-4 lg:pb-14 bg-maes-wine">
  <div class="maes-container flex justify-center">
    <a 
      href="https://premia.condor.com.br/"
      target="_blank"
      rel="noopener noreferrer"
      class="relative w-full max-w-[1350px] lg:max-w-[920px] xl:max-w-[1150px] 2xl:max-w-[1480px] flex items-center group cursor-pointer transition-all hover:brightness-105"
    >
      <!-- Logo Condor Premia (Moved slightly to the left) -->
      <div
        class="absolute left-1/2 -translate-x-1/2 md:left-[1%] md:-translate-x-0 top-0 md:top-1/2 -translate-y-[72%] md:-translate-y-1/2 z-20 w-[35%] md:w-[24%] lg:w-[22%] pointer-events-none"
      >
        <img
          src="/assets/maes/logo-condor-premia.webp"
          alt="Condor Premia"
          width="400"
          height="400"
          class="relative w-full h-auto drop-shadow-[0_15px_30px_rgba(0,0,0,0.4)] scale-110 lg:scale-115 xl:scale-125 transition-transform group-hover:scale-[1.3]"
        />
      </div>

      <!-- Main Banner Structure -->
      <div
        class="w-full bg-white p-[2px] lg:p-[3px] rounded-[32px] md:rounded-full lg:rounded-full shadow-2xl ml-0 md:ml-[8%] lg:ml-[8%] overflow-hidden"
      >
        <div
          class="bg-gradient-to-r from-[#A82128] to-[#CD2027] rounded-[30px] md:rounded-full lg:rounded-full flex flex-col md:flex-row lg:flex-row items-center relative min-h-[130px] md:min-h-[100px] lg:min-h-[110px] xl:min-h-[120px] 2xl:min-h-[140px] px-4 md:pl-[12%] lg:pl-[12%] lg:pr-8 py-4 md:py-4 lg:py-0 gap-4 md:gap-0 lg:gap-0"
        >
          <!-- Content Grid (Using justify-around to center Z-ON naturally) -->
          <div class="flex flex-col md:flex-row lg:flex-row items-center justify-around w-full gap-3 md:gap-4 lg:gap-2 xl:gap-4 2xl:gap-6 mt-6 md:mt-0">
            
            <!-- Promo Blocks Container (Optimized Space) -->
            <div
              class="flex flex-col md:flex-row lg:flex-row items-center justify-between gap-2 md:gap-4 lg:gap-2 xl:gap-6 2xl:gap-8 text-white font-maes-sans"
            >
              <!-- Left Heart -->
              <svg viewBox="0 0 24 24" fill="currentColor" class="text-white h-5 lg:h-6 xl:h-7 2xl:h-8 w-auto shrink-0 drop-shadow-md hidden lg:block">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>

              <!-- 1 Ano Section -->
              <div class="flex flex-col text-center shrink-0">
                <p
                  class="text-[15px] xs:text-lg lg:text-[16px] xl:text-[18px] 2xl:text-[20px] leading-tight tracking-tight uppercase"
                >
                  <span data-content="promoBanner.oneYearTitle" class="text-[#FFCE00] font-black block lg:inline text-[18px] xs:text-[20px] xl:text-[20px] 2xl:text-[24px]"
                    >{promoBanner.oneYearTitle}</span
                  >
                  <span
                    class="font-light block lg:inline text-white text-[14px] xs:text-[16px] lg:text-[13px] xl:text-[18px] 2xl:text-[20px]"
                  >
                    <br class="hidden lg:block" /> <span data-content="promoBanner.oneYearSubtitle">{promoBanner.oneYearSubtitle}</span></span
                  >
                </p>
              </div>
 
              <!-- Middle Heart -->
              <svg viewBox="0 0 24 24" fill="currentColor" class="text-white h-4 lg:h-6 xl:h-7 2xl:h-8 w-auto shrink-0 drop-shadow-md">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
 
              <!-- Vales-Compras Section -->
              <div class="flex flex-col text-center shrink-0">
                <p
                  class="text-[15px] xs:text-lg lg:text-[16px] xl:text-[18px] 2xl:text-[20px] leading-tight tracking-tight uppercase"
                >
                  <span data-content="promoBanner.vouchersTitle" class="text-[#FFCE00] font-black block lg:inline text-[18px] xs:text-[20px] xl:text-[20px] 2xl:text-[24px]"
                    >{promoBanner.vouchersTitle}</span
                  >
                  <span
                    class="font-light block lg:inline text-white text-[14px] xs:text-[16px] lg:text-[13px] xl:text-[18px] 2xl:text-[20px]"
                    ><br class="hidden lg:block" /><span data-content="promoBanner.vouchersSubtitle">{promoBanner.vouchersSubtitle}</span></span
                  >
                </p>
              </div>

              <!-- Right Heart -->
              <svg viewBox="0 0 24 24" fill="currentColor" class="text-white h-5 lg:h-6 xl:h-7 2xl:h-8 w-auto shrink-0 drop-shadow-md hidden lg:block">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </div>
 
            <!-- Z-ON Promo Box (Compact for 1024px) -->
            <div
              class="flex items-center justify-center shrink-0 lg:self-center ml-0 lg:ml-4 xl:ml-12 2xl:ml-16"
            >
              <img
                src="/assets/maes/Chamada Z-ON-1.png"
                alt="Z-ON"
                width="200"
                height="150"
                class="h-20 lg:h-16 xl:h-20 2xl:h-24 w-auto drop-shadow-lg transition-transform hover:scale-105"
              />
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>
</section>
