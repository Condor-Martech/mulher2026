---
import { fetchMaesEvents, getEventStatus, getStatusConfig } from "../../services/maesEventService";
import { getMaesContent } from "../../services/maesService";

const staticData = await getMaesContent();
const events = await fetchMaesEvents();
const { program, ui } = staticData;

// Map static images to dynamic events
const eventsWithMetadata = events.map(event => {
  const staticEvent = program.events.find((e: any) => e.id === event.id);
  const status = getEventStatus(event);
  const statusConfig = getStatusConfig(status);
  
  return {
    ...event,
    image: staticEvent?.image || "/assets/maes/bg-hero-maes.webp",
    description: staticEvent?.description || ui.defaultEventDescription,
    status,
    statusLabel: statusConfig.label,
    statusColor: status === 'OPEN' ? 'bg-maes-primary text-white' : 
                 status === 'SOON' ? 'bg-[#FFCE00] text-black' : 
                 'bg-gray-400 text-white'
  };
});
---

<section id="programacao" class="py-24 bg-white">
  <div class="maes-container">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div class="max-w-xl">
        <h2 class="text-3xl lg:text-4xl font-bold text-maes-secondary font-maes-heading">
          {program.title}
        </h2>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {eventsWithMetadata.map((event: any) => (
        <div data-event-id={event.id} class="group relative bg-maes-bg rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-maes-primary/5">
          <!-- Image & Badge -->
          <div class="aspect-[4/3] overflow-hidden relative">
            <div data-badge class={`absolute top-4 left-4 z-10 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider shadow-lg ${event.statusColor}`}>
              {event.statusLabel}
            </div>
            <img 
              src={event.image} 
              alt={event.tema} 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
          </div>
          
          <!-- Content -->
          <div class="p-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-white text-maes-primary text-xs font-bold rounded-lg shadow-sm">
                {new Date(event.data_evento).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' })}
              </span>
              <span class="text-gray-400 text-xs">•</span>
              <span class="text-gray-500 text-xs font-medium">
                {new Date(event.data_evento).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo' }).replace(':', 'h')}
              </span>
            </div>
            
            <h3 class="text-2xl font-bold text-maes-secondary mb-3">
              {event.tema}
            </h3>
            
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              {event.description}
            </p>
            
            <a data-cta href={event.link_inscripcion} class="inline-flex items-center text-maes-primary font-bold hover:gap-2 transition-all">
              {ui.signUp}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const CAMPAIGN_ID = 'dia-das-maes-2026';

  type StatusKey = 'OPEN' | 'SOON' | 'FULL' | 'FINISHED';
  const STATUS: Record<StatusKey, { label: string; bg: string; color: string; ctaText: string; disabled: boolean }> = {
    OPEN:     { label: 'Inscrições Abertas', bg: '#713334', color: '#fff', ctaText: 'Inscreva-se', disabled: false },
    SOON:     { label: 'Em Breve',           bg: '#FFCE00', color: '#000', ctaText: 'Em Breve',    disabled: true  },
    FULL:     { label: 'Vagas Esgotadas',    bg: '#9ca3af', color: '#fff', ctaText: 'Esgotado',    disabled: true  },
    FINISHED: { label: 'Encerrado',          bg: '#9ca3af', color: '#fff', ctaText: 'Encerrado',   disabled: true  },
  };

  function computeStatus(p: any, crmCount: number, socialCount: number): StatusKey {
    const now = new Date();
    const eventDate = new Date(p.data_evento);
    const openDate = p.data_abertura_inscricao ? new Date(p.data_abertura_inscricao) : null;

    if (!p.active || now > eventDate) return 'FINISHED';
    if (!openDate || now < openDate) return 'SOON';

    const params = new URLSearchParams(window.location.search);
    const src = params.get('src') ?? (window.location.pathname.includes('/palestra/') ? 'crm' : 'social');

    if (src === 'crm' && p.qtd_crm != null && crmCount >= p.qtd_crm) return 'FULL';
    if (src === 'social' && p.qtd_social != null && socialCount >= p.qtd_social) return 'FULL';

    return 'OPEN';
  }

  async function hydrateEvents() {
    try {
      const headers = { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` };

      const [palestrasRes, inscricoesRes] = await Promise.all([
        fetch(`${SUPABASE_URL}/rest/v1/palestras?active=eq.true&campanha_id=eq.${CAMPAIGN_ID}&select=id,data_evento,data_abertura_inscricao,active,qtd_crm,qtd_social`, { headers }),
        fetch(`${SUPABASE_URL}/rest/v1/inscricoes?campanha_id=eq.${CAMPAIGN_ID}&select=event_id,source`, { headers }),
      ]);

      if (!palestrasRes.ok || !inscricoesRes.ok) return;

      const palestras = await palestrasRes.json();
      const inscricoes = await inscricoesRes.json();

      palestras.forEach((p: any) => {
    async function hydrateEvents() {
      console.log('[EventGrid] Starting hydration...');
      const grid = document.getElementById('event-grid-maes');
      if (!grid) {
        console.warn('[EventGrid] Grid element not found');
        return;
      }

      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
      const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

      if (!supabaseUrl || !supabaseKey) {
        console.error('[EventGrid] Missing Supabase environment variables. Check your CI/CD secrets.');
        return;
      }

      try {
        const response = await fetch(
          `${supabaseUrl}/rest/v1/maes_events?select=id,registrations_count,max_capacity,status`,
          {
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`
            }
          }
        );

        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        
        const events = await response.json();
        console.log('[EventGrid] Data fetched:', events);
        
        const eventsMap = events.reduce((acc: any, event: any) => {
          acc[event.id] = event;
          return acc;
        }, {});

        // Update all cards
        const cards = grid.querySelectorAll('[data-event-id]');
        cards.forEach((card) => {
          const eventId = card.getAttribute('data-event-id');
          const event = eventsMap[eventId || ''];
          
          if (!event) return;

          // Logic to determine status
          let finalStatus = event.status;
          if (finalStatus === 'open' && event.registrations_count >= event.max_capacity) {
            finalStatus = 'full';
          }

          // Update Badge
          const badge = card.querySelector('[data-badge]');
          if (badge) {
            if (finalStatus === 'full') {
              badge.textContent = 'ESGOTADO';
              badge.className = 'absolute -top-3 left-1/2 -translate-x-1/2 bg-[#713334] text-white px-4 py-1 rounded-full text-xs font-bold shadow-lg whitespace-nowrap z-20';
            } else if (finalStatus === 'soon') {
              badge.textContent = 'INSCRIÇÕES EM BREVE';
              badge.className = 'absolute -top-3 left-1/2 -translate-x-1/2 bg-[#FFCE00] text-[#713334] px-4 py-1 rounded-full text-xs font-bold shadow-lg whitespace-nowrap z-20';
            } else {
              badge.textContent = 'INSCRIÇÕES ABERTAS';
              badge.className = 'absolute -top-3 left-1/2 -translate-x-1/2 bg-[#FFCE00] text-[#713334] px-4 py-1 rounded-full text-xs font-bold shadow-lg whitespace-nowrap z-20';
            }
          }

          // Update CTA Button
          const cta = card.querySelector('[data-cta]');
          if (cta) {
            if (finalStatus === 'full') {
              cta.textContent = 'Esgotado';
              (cta as HTMLButtonElement).disabled = true;
              cta.className = 'w-[85%] py-3 lg:py-3 xl:py-4 2xl:py-5 px-6 rounded-xl font-maes-sans font-bold text-xl lg:text-xl xl:text-2xl transition-all duration-300 shadow-lg mx-auto mb-2 tracking-tight bg-gray-400 text-white cursor-not-allowed opacity-70';
            } else if (finalStatus === 'soon') {
              cta.textContent = 'Em Breve';
              (cta as HTMLButtonElement).disabled = true;
              cta.className = 'w-[85%] py-3 lg:py-3 xl:py-4 2xl:py-5 px-6 rounded-xl font-maes-sans font-bold text-xl lg:text-xl xl:text-2xl transition-all duration-300 shadow-lg mx-auto mb-2 tracking-tight bg-[#E9969F] text-white cursor-not-allowed opacity-70';
            } else {
              cta.textContent = 'Inscreva-se';
              (cta as HTMLButtonElement).disabled = false;
              cta.className = 'open-event-modal-btn w-[85%] py-3 lg:py-3 xl:py-4 2xl:py-5 px-6 rounded-xl font-maes-sans font-bold text-xl lg:text-xl xl:text-2xl transition-all duration-300 shadow-lg mx-auto mb-2 tracking-tight bg-[#713334] text-white hover:scale-[1.02] active:scale-[0.98] cursor-pointer';
            }
          }
        });
      } catch (e) {
        console.error('[EventGrid] Hydration failed:', e);
      }
    }
    });
  } catch (e) {
    console.error('[EventGrid] Outer hydration failed:', e);
  }
}



    // Run when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hydrateEvents);
    } else {
      hydrateEvents();
    }
  </script>
