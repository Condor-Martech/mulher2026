---
import { getMaesContent } from "../../services/maesService";

const data = await getMaesContent();
const { personas, ui } = data;
---

<section id="personas" class="pt-0 pb-4 lg:pb-16 bg-maes-wine px-6 lg:px-7 xl:px-14 2xl:px-20 overflow-hidden">
  <div class="relative lg:max-w-[940px] xl:max-w-[1260px] 2xl:max-w-[1440px] mx-auto">
    <!-- Atmospheric Glow -->
    <div class="maes-glow-bg top-[20%] right-[-10%] opacity-10 pointer-events-none" style="width: 400px; height: 400px;"></div>

    <div 
      id="persona-carousel"
      class="maes-container flex flex-row lg:flex-col gap-8 lg:gap-16 overflow-x-auto lg:overflow-visible snap-x snap-mandatory hide-scrollbar -mx-5 px-5 lg:mx-auto lg:px-0 pb-10 lg:pb-0"
    >
      {
        personas.map((persona: any, idx: number) => {
          const shiftDir = idx % 2 === 0 ? "lg:-translate-x-12 xl:-translate-x-24" : "lg:translate-x-12 xl:translate-x-24";
          return (
            <article 
              class:list={[
                "reveal flex flex-col lg:flex-row items-stretch rounded-[40px] lg:rounded-[48px] overflow-hidden maes-card-shadow bg-maes-card shrink-0 w-[85vw] lg:w-full max-w-[1100px] snap-center min-h-[460px] h-auto lg:h-[420px] xl:h-[460px] transition-all duration-700 hover:scale-[1.01] hover:z-20 mx-auto mb-3 lg:mb-8"
              ]}
              style={`transition-delay: ${idx * 150}ms`}
            >
              <div class="h-[240px] lg:h-full lg:w-[42%] shrink-0 overflow-hidden relative">
                <img
                  src={persona.image}
                  alt={persona.name}
                  class="w-full h-full object-cover object-top block transition-transform duration-1000 hover:scale-105"
                />
              </div>
              <div class="flex-1 flex flex-col justify-start px-6 lg:px-14 xl:px-20 pt-4 lg:pt-10 pb-8 lg:pb-8 text-left relative">
                <h3 class="font-maes-script text-maes-primary text-[32px] xs:text-[38px] lg:text-[48px] xl:text-[62px] leading-tight mb-1 lg:mb-4">
                  {persona.name}
                </h3>
                
                <p class="font-maes-sans text-maes-primary/90 text-lg lg:text-xl xl:text-2xl leading-relaxed max-w-[500px] lg:mx-0 pb-6 lg:pb-12 xl:pb-16">
                  {persona.description}
                </p>

                <div class="mt-auto flex items-center justify-end gap-6 lg:gap-6 lg:absolute lg:bottom-10 lg:right-14">
                  {persona.partnerLogo && (
                    <img 
                      src={persona.partnerLogo} 
                      alt="Partner Logo" 
                      class="h-14 lg:h-10 w-auto object-contain opacity-90"
                    />
                  )}
                  {persona.campaignLogo && (
                    <img 
                      src={persona.campaignLogo || "/assets/maes/logo-clube-transparente.webp"} 
                      alt="Campaign Logo" 
                      class="h-18 lg:h-12 w-auto object-contain opacity-90"
                    />
                  )}
                </div>
                
                <!-- Decorative Element -->
                <div class="hidden lg:block absolute top-6 right-8 opacity-5">
                   <svg width="40" height="40" viewBox="0 0 100 100" fill="currentColor" class="text-maes-primary">
                     <path d="M50 0C50 27.6142 27.6142 50 0 50C27.6142 50 50 72.3858 50 100C50 72.3858 72.3858 50 100 50C72.3858 50 50 27.6142 50 0Z"/>
                   </svg>
                </div>
              </div>
            </article>
          )
        })
      }
    </div>


    <button 
      id="persona-arrow"
      aria-label={ui.nextPerson}
      class="lg:hidden absolute right-3 top-[35%] -translate-y-1/2 z-30 animate-bounce-horizontal"
    >
      <div class="bg-maes-accent/90 backdrop-blur-sm p-4 rounded-full shadow-[0_10px_30px_-5px_rgba(255,206,0,0.5)] border-2 border-white/20 active:scale-95 transition-all duration-500">
        <svg
          id="persona-arrow-svg"
          class="w-7 h-7 text-maes-primary transition-transform duration-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="4"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </div>
    </button>
  </div>
</section>

<script>
  const carousel = document.getElementById('persona-carousel');
  const arrow = document.getElementById('persona-arrow');
  const arrowSvg = document.getElementById('persona-arrow-svg');
  let isAtEnd = false;

  if (carousel && arrow && arrowSvg) {
    arrow.addEventListener('click', () => {
      if (isAtEnd) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        const cardWidth = carousel.querySelector('article')?.offsetWidth || 0;
        const gap = 20; // gap-5 in tailwind
        carousel.scrollBy({ 
          left: cardWidth + gap, 
          behavior: 'smooth' 
        });
      }
    });

    carousel.addEventListener('scroll', () => {
      // Increased tolerance for end-of-scroll detection to ensure it triggers correctly
      isAtEnd = carousel.scrollLeft + carousel.offsetWidth >= carousel.scrollWidth - 50;
      arrowSvg.style.transform = isAtEnd ? 'rotate(180deg)' : 'rotate(0deg)';
    });
  }
</script>

<style>
  @keyframes bounce-horizontal {
    0%, 100% { transform: translate(0, -50%); }
    50% { transform: translate(10px, -50%); }
  }
  .animate-bounce-horizontal {
    animation: bounce-horizontal 2s infinite;
  }
</style>
