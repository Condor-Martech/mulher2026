---
import SpinnerIcon from "./icons/SpinnerIcon.astro";

interface Props {
  eventId?: string;
  eventTema?: string;
  campaign?: "maes" | "mulher";
}

const { eventId = "", eventTema = "", campaign = "maes" } = Astro.props;

// Campaign-specific styling
const styles = {
  maes: {
    label: "text-[#713334]",
    inputBorder: "border-maes-primary/20",
    inputFocus: "focus:ring-maes-primary/50 focus:border-maes-primary",
    button: "bg-maes-primary hover:bg-maes-wine",
    shadow: "hover:shadow-[0_10px_20px_rgba(113,51,52,0.3)]",
  },
  mulher: {
    label: "text-[#5A4A4A]",
    inputBorder: "border-primary/20",
    inputFocus: "focus:ring-primary/50 focus:border-primary",
    button: "bg-primary hover:bg-primary/90",
    shadow: "hover:shadow-[0_10px_20px_rgba(235,93,121,0.3)]",
  }
};

const currentStyle = styles[campaign];
---

<form id="event-registration-form" class="flex flex-col gap-2 md:gap-4">
  <input type="hidden" id="modal-event-id" name="eventId" value={eventId} />
  <input type="hidden" id="modal-event-tema" name="eventTema" value={eventTema} />

  <div class="grid grid-cols-2 gap-2 md:gap-4">
    <div class="flex flex-col gap-0.5 col-span-2 md:col-span-1">
      <label
        for="nome"
        class={`text-[11px] md:text-sm font-bold pl-1 md:pl-2 ${currentStyle.label}`}
        >Nome Completo</label
      >
      <input
        type="text"
        id="nome"
        name="nome"
        required
        placeholder="Digite seu nome"
        class={`w-full px-3 py-1.5 md:px-4 md:py-3 rounded-xl bg-white border ${currentStyle.inputBorder} focus:outline-none focus:ring-2 ${currentStyle.inputFocus} transition-all text-sm md:text-base text-[#5A4A4A] placeholder:text-[#A99D9D]`}
      />
      <span
        class="error-message hidden text-red-500 text-[10px] md:text-xs pl-1 md:pl-2 font-medium"
        >Por favor, insira um nome válido.</span
      >
    </div>

    <div class="flex flex-col gap-0.5 col-span-2 md:col-span-1">
      <label
        for="email"
        class={`text-[11px] md:text-sm font-bold pl-1 md:pl-2 ${currentStyle.label}`}
        >E-mail</label
      >
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="seu@email.com"
        class={`w-full px-3 py-1.5 md:px-4 md:py-3 rounded-xl bg-white border ${currentStyle.inputBorder} focus:outline-none focus:ring-2 ${currentStyle.inputFocus} transition-all text-sm md:text-base text-[#5A4A4A] placeholder:text-[#A99D9D]`}
      />
      <span
        class="error-message hidden text-red-500 text-[10px] md:text-xs pl-1 md:pl-2 font-medium"
        >Por favor, insira um e-mail válido.</span
      >
    </div>

    <div class="flex flex-col gap-0.5 col-span-1">
      <label
        for="telefone"
        class={`text-[11px] md:text-sm font-bold pl-1 md:pl-2 ${currentStyle.label}`}
        >Telefone / WhatsApp</label
      >
      <input
        type="tel"
        id="telefone"
        name="telefone"
        required
        placeholder="(00) 00000-0000"
        maxlength="15"
        class={`w-full px-2 py-1.5 md:px-4 md:py-3 rounded-xl bg-white border ${currentStyle.inputBorder} focus:outline-none focus:ring-2 ${currentStyle.inputFocus} transition-all text-[12px] md:text-base text-[#5A4A4A] placeholder:text-[#A99D9D]`}
      />
      <span
        class="error-message hidden text-red-500 text-[10px] md:text-xs pl-1 md:pl-2 font-medium"
        >Telefone inválido.</span
      >
    </div>

    <div class="flex flex-col gap-0.5 col-span-1">
      <label
        for="cpf"
        class={`text-[11px] md:text-sm font-bold pl-1 md:pl-2 ${currentStyle.label}`}
        >CPF</label
      >
      <input
        type="text"
        id="cpf"
        name="cpf"
        required
        placeholder="000.000.000-00"
        maxlength="14"
        class={`w-full px-2 py-1.5 md:px-4 md:py-3 rounded-xl bg-white border ${currentStyle.inputBorder} focus:outline-none focus:ring-2 ${currentStyle.inputFocus} transition-all text-[12px] md:text-base text-[#5A4A4A] placeholder:text-[#A99D9D]`}
      />
      <span
        class="error-message hidden text-red-500 text-[10px] md:text-xs pl-1 md:pl-2 font-medium"
        >CPF inválido.</span
      >
    </div>
  </div>

  {campaign === 'maes' && (
    <div class="mt-1 md:mt-2 pt-2 md:pt-4 border-t border-maes-primary/10 flex flex-col gap-2 md:gap-4">
      <div class="flex items-center gap-2 mb-1 md:mb-0">
        <div class="w-6 h-6 md:w-7 md:h-7 rounded-full bg-maes-primary/10 flex items-center justify-center">
          <span class="text-maes-primary font-bold text-xs md:text-sm">2</span>
        </div>
        <h3 class="text-sm md:text-sm font-black text-maes-wine uppercase tracking-wider">Acompanhante (Filho/a)</h3>
      </div>
      
      <div class="grid grid-cols-2 gap-2 md:gap-4">
        <div class="flex flex-col gap-0.5 col-span-2 md:col-span-1">
          <label for="nome_filho" class={`text-[11px] md:text-sm font-bold pl-1 md:pl-2 ${currentStyle.label}`}>Nome Completo</label>
          <input type="text" id="nome_filho" name="nome_filho" required placeholder="Nome do filho(a)" class={`w-full px-3 py-1.5 md:px-4 md:py-3 rounded-xl bg-white border ${currentStyle.inputBorder} focus:outline-none focus:ring-2 ${currentStyle.inputFocus} transition-all text-sm md:text-base text-[#5A4A4A] placeholder:text-[#A99D9D]`} />
          <span class="error-message hidden text-red-500 text-[10px] md:text-xs pl-1 md:pl-2 font-medium">Nome obrigatório.</span>
        </div>

        <div class="flex flex-col gap-0.5 col-span-2 md:col-span-1">
          <label for="cpf_filho" class={`text-[11px] md:text-sm font-bold pl-1 md:pl-2 ${currentStyle.label}`}>CPF do Filho(a)</label>
          <input type="text" id="cpf_filho" name="cpf_filho" required placeholder="000.000.000-00" maxlength="14" class={`w-full px-3 py-1.5 md:px-4 md:py-3 rounded-xl bg-white border ${currentStyle.inputBorder} focus:outline-none focus:ring-2 ${currentStyle.inputFocus} transition-all text-[12px] md:text-base text-[#5A4A4A] placeholder:text-[#A99D9D]`} />
          <span class="error-message hidden text-red-500 text-[10px] md:text-xs pl-1 md:pl-2 font-medium">CPF inválido.</span>
        </div>
      </div>

      <div class="flex flex-col gap-0.5 px-1">
        <div class="flex items-start gap-2 md:gap-3">
          <input type="checkbox" id="maioridade_filho" name="maioridade_filho" required class={`mt-0.5 w-4 h-4 md:w-5 md:h-5 rounded border-gray-300 text-maes-primary focus:ring-maes-primary/50 cursor-pointer transition-colors`} />
          <label for="maioridade_filho" class="text-[10px] md:text-xs text-[#6D5D5D] leading-tight cursor-pointer">
            Confirmo que o acompanhante é <strong>maior de 18 anos</strong>. (Obrigatório por bebidas alcoólicas)
          </label>
        </div>
        <span class="error-message hidden text-red-500 text-[10px] md:text-xs font-medium">Obrigatório.</span>
      </div>
    </div>
  )}

  <div class="flex flex-col gap-0.5 mt-1 px-1">
    <div class="flex items-start gap-2 md:gap-3">
      <input
        type="checkbox"
        id="lgpd"
        name="lgpd"
        required
        class={`mt-0.5 w-4 h-4 md:w-5 md:h-5 rounded border-gray-300 ${campaign === 'maes' ? 'text-maes-primary focus:ring-maes-primary/50' : 'text-primary focus:ring-primary/50'} cursor-pointer transition-colors`}
      />
      <label
        for="lgpd"
        class="text-[10px] md:text-xs text-[#6D5D5D] leading-tight cursor-pointer"
      >
        Autorizo o uso dos meus dados pela Rede Condor para envio de comunicações
        sobre o evento e conforme a nossa política de privacidade.
      </label>
    </div>
    <span class="error-message hidden text-red-500 text-[10px] md:text-xs font-medium"
      >Aceite obrigatório.</span
    >
  </div>

  <button
    type="submit"
    id="submit-registration-btn"
    disabled
    class={`mt-1 md:mt-2 w-full px-6 py-2.5 md:px-8 md:py-3.5 ${currentStyle.button} text-white text-sm md:text-lg font-bold rounded-xl md:rounded-xl ${currentStyle.shadow} transform transition-all shadow-premium active:scale-95 flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 disabled:active:scale-100 disabled:opacity-70 disabled:hover:shadow-none`}
  >
    <span id="submit-text">Confirmar Inscrição</span>
    <SpinnerIcon
      id="submit-spinner"
      class="animate-spin hidden h-5 w-5 text-white"
    />
  </button>
</form>

<script>
  import { initFormHandler } from "../utils/formHandler";

  // Astro runs this on load
  initFormHandler();
</script>
