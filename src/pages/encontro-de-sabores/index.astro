---
// Encontro de Sabores Condor — única rota da campanha.
//
// SSR (sem `prerender`), como as demais campanhas com inscrição: o estado das
// vagas não pode vir de cache nem ser calculado no build, tem que ser
// consultado a cada requisição.
//
// O estado sai de obterEstado(): ele consulta no Supabase a linha do evento em
// `palestras` com campanha_id = 'encontro-de-sabores' e calcula o status com
// utils/eventStatus.ts, igual a /maes/palestra/[id] e /sabores-de-inverno.
// Enquanto essa linha não existir, o retorno é 'SOON', que é o estado real: o
// briefing abre as inscrições em 04/09/2026 e a data ainda não chegou.
import LayoutEncontroSabores from "../../layouts/LayoutEncontroSabores.astro";
import Hero from "../../components/encontro-de-sabores/Hero.astro";
import Evento from "../../components/encontro-de-sabores/Evento.astro";
import ModalInscricao from "../../components/encontro-de-sabores/ModalInscricao.astro";
import { obterEstado } from "../../services/encontroEventService";
import Patrocinadores from "../../components/encontro-de-sabores/Patrocinadores.astro";
import RodapeEncontro from "../../components/encontro-de-sabores/RodapeEncontro.astro";

// Estado da inscrição. Não há valor fixo aqui: quem calcula é o
// eventStatus.ts em SSR, a partir da linha do evento em `palestras`.
//
// O formulário fica em MODAL, como no resto do repo (EventModal.astro,
// SaboresEventModal.astro). Assim a página não cresce em relação ao Figma —que
// não traz bloco de inscrição— e quem abre é o CTA «INSCREVA-SE» do design.
//
// Este é o canal WEB (src=social, cota qtd_social: as 15 vagas da LP).
// O canal CRM tem a própria rota, com o formulário inline, em
// /encontro-de-sabores/crm/, igual a /maes/palestra/[id] e sabores.
// Estado real, a cada requisição. Enquanto a linha do evento não existir em
// `palestras` com campanha_id = 'encontro-de-sabores', devolve SOON e a página
// continua de pé: não estoura por causa de uma linha que ainda não está lá.
const { status: estado, eventId } = await obterEstado("social");

// Dados ao vivo: nada de cache enquanto houver vagas a contar.
Astro.response.headers.set("Cache-Control", "no-store");
---

<LayoutEncontroSabores>
  <main>
    <Hero />
    <Evento />
    <Patrocinadores />
  </main>

  {/* Fora do <main>: é um diálogo, não conteúdo da página. */}
  <ModalInscricao estado={estado} eventId={eventId} />
  <RodapeEncontro />
</LayoutEncontroSabores>
