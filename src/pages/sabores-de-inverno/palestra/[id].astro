---
import LayoutSaboresInverno from "../../../layouts/LayoutSaboresInverno.astro";
import SaboresFeedbackModal from "../../../components/sabores/SaboresFeedbackModal.astro";
import { computeEventStatus } from "../../../utils/eventStatus";
import type { Event, EventStatus } from "../../../types/event";
import { supabase } from "../../../lib/supabase";

// Landing directa por evento (canal CRM por defecto). SSR en cada request:
// estado en tiempo real por cupo qtd_crm. Espeja el patrón de maes/palestra,
// pero con el cómputo de estado completo de Sabores (apertura escalonada + gate +18).
const CAMPAIGN_ID = "sabores-de-inverno-2026";

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const [{ data: palestra, error }, { data: campanha }] = await Promise.all([
  supabase
    .from("palestras")
    .select("*")
    .eq("id", id)
    .eq("active", true)
    .eq("campanha_id", CAMPAIGN_ID)
    .maybeSingle(),
  supabase
    .from("campanhas")
    .select("active")
    .eq("id", CAMPAIGN_ID)
    .maybeSingle(),
]);

if (error || !palestra) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Canal: las landings directas son CRM por defecto; ?src=social lo cambia.
const urlSrc = Astro.url.searchParams.get("src");
const source: "social" | "crm" = urlSrc === "social" ? "social" : "crm";

// Conteo en vivo del cupo del canal resuelto (mismo patrón que maes).
const quota =
  source === "crm" ? (palestra.qtd_crm ?? 0) : (palestra.qtd_social ?? 0);
let current = 0;
if (quota > 0) {
  const { count } = await supabase
    .from("inscricoes")
    .select("*", { count: "exact", head: true })
    .eq("event_id", palestra.id)
    .eq("source", source);
  current = count ?? 0;
}

// Event mínimo para reusar el cómputo de estado (OPEN/SOON/FULL/FINISHED).
const event: Event = {
  id: palestra.id,
  tema: palestra.nome,
  palestrante: palestra.palestrante,
  data_evento: palestra.data_evento,
  data_abertura_inscricao: palestra.data_abertura_inscricao,
  data_limite_inscricao: palestra.data_limite_inscricao,
  link_inscripcion: `/sabores-de-inverno/palestra/${palestra.id}/`,
  tipo_evento: palestra.tipo_evento || "Evento",
  is_active: palestra.active,
  campanha_active: campanha?.active ?? true,
  qtd_crm: palestra.qtd_crm,
  qtd_social: palestra.qtd_social,
  current_crm: source === "crm" ? current : 0,
  current_social: source === "social" ? current : 0,
  data: palestra.data ?? null,
  region: palestra.data?.region,
  location: palestra.data?.location,
  brand: palestra.data?.brand,
  sponsor: palestra.data?.sponsor,
  time_label: palestra.data?.time_label,
};

const status: EventStatus = computeEventStatus(event, { source });
const isOpen = status === "OPEN";

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=30, stale-while-revalidate=60",
);

// ─── Header del card: mismo "modelo simple" que el modal social ───
// SaboresEventModal muestra: tema (sans-bold) · fecha "Quarta-feira, 01 de julho · HH"
// (sin año) · "Cidade · Sede". Esta landing CRM clona ese header exacto.
const dateObj = new Date(event.data_evento);
const valid = !isNaN(dateObj.getTime());
const part = (opts: Intl.DateTimeFormatOptions) =>
  valid
    ? new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", ...opts })
        .format(dateObj)
        .replace(".", "")
    : "";
const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
const time =
  event.time_label && event.time_label.toLowerCase() !== "a definir"
    ? event.time_label
    : "";
const dateFull = valid
  ? `${cap(part({ weekday: "long" }))}, ${part({ day: "2-digit", month: "long" })}${time ? ` · ${time}` : ""}`
  : "";

const REGION_NAMES: Record<string, string> = {
  curitiba: "Curitiba",
  maringa: "Maringá",
  pontagrossa: "Ponta Grossa",
};
const regionKey = (event.region ?? "").toLowerCase().replace(/\s+/g, "");
const city = REGION_NAMES[regionKey] ?? event.region ?? "";
const cityLine = [city, event.location].filter(Boolean).join(" · ");
// Link a Google Maps: override explícito por evento (data.maps_url) o búsqueda por
// nombre de tienda + ciudad. Mismo criterio que la card de la grilla social.
const mapsOverride =
  (event.data?.maps_url as string | undefined) ??
  (event.data?.mapsUrl as string | undefined);
const mapsQuery = [event.location, city].filter(Boolean).join(" ").trim();
const mapsUrl =
  mapsOverride ||
  (mapsQuery
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`
    : null);
// Palestrante: se muestra en el header del form; oculta placeholders "a definir/confirmar".
const palestrante =
  event.palestrante &&
  !/^a\s+(definir|confirmar)/i.test(event.palestrante.trim())
    ? event.palestrante
    : "";

// ─── Bloque de estado cuando NO está abierto (FULL/SOON/FINISHED) ───
const stateCopy: Record<
  Exclude<EventStatus, "OPEN">,
  { title: string; message: string }
> = {
  FULL: {
    title: "Vagas Esgotadas",
    message: "Desculpe, todas as vagas para esta edição já foram preenchidas.",
  },
  SOON: {
    title: "Inscrições em breve",
    message:
      "As inscrições para esta edição ainda não abriram. Volte mais perto da data para garantir a sua vaga.",
  },
  FINISHED: {
    title: "Inscrições encerradas",
    message:
      "As inscrições para esta edição foram encerradas. Acompanhe as próximas edições do Sabores de Inverno.",
  },
};
const state = !isOpen ? stateCopy[status as Exclude<EventStatus, "OPEN">] : null;

// Mismas clases de campo que el modal social (SaboresEventModal) → forms idénticos.
const inputCls =
  "w-full px-3 py-2 rounded-xl bg-chocolate-dark/60 border border-gold/25 text-latte placeholder:text-latte/30 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition text-sm";
const labelCls =
  "text-[0.7rem] font-bold uppercase tracking-wider text-gold/80 pl-1";
const errCls =
  "sabores-error hidden text-red-400 text-[0.65rem] pl-1 font-medium";
---

<LayoutSaboresInverno title={`${event.tema} — Sabores de Inverno 2026`}>
  <main
    class="relative z-10 min-h-[100dvh] w-full flex items-center justify-center px-4 py-10"
  >
    <!-- Card único, idéntico al modal social ("modelo simple") -->
    <div class="w-full max-w-[480px] mx-auto">
      {
        isOpen ? (
          <div
            class="rounded-3xl border border-gold/25 p-6 md:p-8 shadow-2xl"
            style="background: linear-gradient(160deg, #2C1A11 0%, #160B06 100%);"
          >
            <span class="section-pretitle">Inscrição</span>
            <h1 class="font-sans font-extrabold text-2xl text-cream leading-tight mb-1">
              {event.tema}
            </h1>
            <div class="mb-6 mt-3 flex flex-col gap-2.5">
              {dateFull && (
                <div>
                  <p class="text-[0.6rem] font-bold uppercase tracking-widest text-gold/60">Data & Hora</p>
                  <p class="text-gold text-sm font-bold">{dateFull}</p>
                </div>
              )}
              {cityLine && (
                <div>
                  <p class="text-[0.6rem] font-bold uppercase tracking-widest text-gold/60">Local</p>
                  {mapsUrl ? (
                    <a
                      href={mapsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-latte text-sm font-semibold hover:text-gold transition-colors"
                      aria-label={`Ver ${cityLine} no Google Maps`}
                    >
                      <svg class="w-3.5 h-3.5 text-gold shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                        <circle cx="12" cy="11" r="3" />
                      </svg>
                      <span>{cityLine}</span>
                      <span class="text-2xs font-bold uppercase tracking-wider text-gold underline underline-offset-2 opacity-80 group-hover:opacity-100">Ver no mapa</span>
                    </a>
                  ) : (
                    <p class="text-latte text-sm font-semibold">{cityLine}</p>
                  )}
                </div>
              )}
              {palestrante && (
                <div>
                  <p class="text-[0.6rem] font-bold uppercase tracking-widest text-gold/60">Palestrante</p>
                  <p class="text-latte text-sm font-semibold">{palestrante}</p>
                </div>
              )}
            </div>

            <form
              id="sabores-crm-form"
              class="flex flex-col gap-3"
              data-source={source}
              novalidate
            >
              <input
                type="hidden"
                id="sabores-crm-event-id"
                name="eventId"
                value={event.id}
              />
              <input type="hidden" name="eventTema" value={event.tema} />

              <div class="grid grid-cols-2 gap-3">
                <div class="col-span-2 flex flex-col gap-1">
                  <label class={labelCls} for="crm-nome">
                    Nome completo
                  </label>
                  <input
                    id="crm-nome"
                    name="nome"
                    type="text"
                    required
                    placeholder="Seu nome"
                    class={inputCls}
                  />
                  <span class={errCls}>Informe um nome válido.</span>
                </div>

                <div class="col-span-2 flex flex-col gap-1">
                  <label class={labelCls} for="crm-email">
                    E-mail
                  </label>
                  <input
                    id="crm-email"
                    name="email"
                    type="email"
                    required
                    placeholder="seu@email.com"
                    class={inputCls}
                  />
                  <span class={errCls}>E-mail inválido.</span>
                </div>

                <div class="flex flex-col gap-1">
                  <label class={labelCls} for="crm-telefone">
                    Telefone
                  </label>
                  <input
                    id="crm-telefone"
                    name="telefone"
                    type="tel"
                    required
                    maxlength="15"
                    placeholder="(00) 00000-0000"
                    class={inputCls}
                  />
                  <span class={errCls}>Telefone inválido.</span>
                </div>

                <div class="flex flex-col gap-1">
                  <label class={labelCls} for="crm-cpf">
                    CPF
                  </label>
                  <input
                    id="crm-cpf"
                    name="cpf"
                    type="text"
                    required
                    maxlength="14"
                    placeholder="000.000.000-00"
                    class={inputCls}
                  />
                  <span class={errCls}>CPF inválido.</span>
                </div>
              </div>

              {/* +18: obrigatório em TODOS os eventos da campanha (regra global). */}
              <label class="flex items-start gap-2 text-xs text-latte/80 cursor-pointer pl-1">
                <input
                  id="crm-maioridade"
                  name="maioridade"
                  type="checkbox"
                  required
                  class="mt-0.5 accent-gold w-4 h-4 shrink-0"
                />
                <span>
                  Confirmo que sou <strong>maior de 18 anos</strong>. (Evento
                  exclusivo para maiores de idade)
                </span>
              </label>

              <label class="flex items-start gap-2 text-xs text-latte/80 cursor-pointer pl-1">
                <input
                  id="crm-lgpd"
                  name="lgpd"
                  type="checkbox"
                  required
                  class="mt-0.5 accent-gold w-4 h-4 shrink-0"
                />
                <span>
                  Autorizo a Rede Condor a utilizar meus dados para
                  comunicações e minha imagem em conteúdos relacionados aos
                  eventos e iniciativas da empresa, conforme a Política de
                  Privacidade.
                </span>
              </label>

              <button
                id="sabores-crm-submit"
                type="submit"
                disabled
                class="btn-primary w-full mt-1 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 flex items-center justify-center gap-2"
              >
                <span id="sabores-crm-submit-text">Confirmar inscrição</span>
                <svg
                  id="sabores-crm-spinner"
                  class="hidden animate-spin h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                  />
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
                  />
                </svg>
              </button>
            </form>
          </div>
        ) : (
          <div
            id="sabores-state-block"
            data-event-id={event.id}
            data-status={status}
            class="rounded-3xl border border-gold/25 p-8 text-center shadow-2xl"
            style="background: linear-gradient(160deg, #2C1A11 0%, #160B06 100%);"
          >
            <div class="w-14 h-14 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center mx-auto mb-4">
              {status === "FULL" ? (
                <svg
                  class="w-7 h-7 text-gold"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"
                  />
                </svg>
              ) : (
                <svg
                  class="w-7 h-7 text-gold"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              )}
            </div>
            <h1 class="font-sans font-extrabold text-2xl text-cream mb-2">
              {state?.title}
            </h1>
            <p class="text-latte/70 text-sm leading-relaxed">
              {state?.message}
            </p>
            <a
              href="/sabores-de-inverno/#programacao"
              class="btn-secondary inline-block mt-6"
            >
              Ver outras edições
            </a>
          </div>
        )
      }
    </div>
  </main>

  <SaboresFeedbackModal />
</LayoutSaboresInverno>

<script>
  import { track } from "../../../lib/track";
  import { initSaboresCrmForm } from "../../../utils/saboresCrmForm";

  initSaboresCrmForm();

  // Landing standalone (sin ClientRouter): el script corre una sola vez por carga.
  const state = document.getElementById("sabores-state-block");
  if (state && state.dataset.status === "FULL") {
    track("vagas_esgotadas_viewed", {
      event_id: state.dataset.eventId || "",
    });
  }
</script>
