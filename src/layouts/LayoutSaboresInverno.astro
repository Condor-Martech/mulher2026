---
// Layout exclusivo de Sabores de Inverno 2026.
// Importa SOLO su propio CSS (bundle aislado): sus tokens @theme y su `.bg-grain`
// oscuro no interfieren con mulher/maes/pascoa (cada página carga su layout).
import "../styles/saboresInverno.css";
import settings from "../data/settings.json";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sabores de Inverno Condor 2026: festivais gastronômicos exclusivos por cidade. Reserve sua agenda e garanta sua vaga.",
} = Astro.props;
const { gtmId } = settings;
const ogImage = "/assets/sabores-de-inverno/hero-kv.png";

// Una sola fuente de verdad para el href de Google Fonts (cargado async + fallback noscript).
const fontsHref =
  "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&family=Great+Vibes&display=swap";
---

<!doctype html>
<html lang="pt-br" class="overflow-x-hidden w-full max-w-[100vw]">
  <head>
    {/* charset + viewport PRIMERO: deben caer en los primeros 1024 bytes
        (auditoría Lighthouse "charset"), antes de los scripts de GTM/OpenPanel. */}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}
    <Analytics />
    <link rel="icon" type="image/png" href="/favicon-64.png" sizes="64x64" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2B1D14" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Sabores Fonts: Inter (body), Playfair Display (display italic), Great Vibes (script).
        Carga async (media=print → onload) para no bloquear el render; display=swap ya
        pinta en la tipografía de respaldo y cambia al cargar. <noscript> = fallback sin JS. */}
    <link
      rel="stylesheet"
      href={fontsHref}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href={fontsHref} />
    </noscript>
  </head>
  <body class="text-latte font-sans antialiased relative min-h-screen w-full overflow-x-hidden bg-grain">
    {gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <slot />
  </body>
</html>
